<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="FileToMarkdown.App.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileToMarkdown.App"
    xmlns:models="using:FileToMarkdown.App.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid x:Name="Root" Padding="20" RowSpacing="14"
          Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Width="34" Height="34" VerticalAlignment="Center" Margin="0,0,12,0">
                <Image.Source>
                    <SvgImageSource UriSource="ms-appx:///Assets/logo.svg" />
                </Image.Source>
            </Image>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="File to Markdown Converter" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Batch-convert documents, images and scanned PDFs to Markdown — offline."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="2" VerticalAlignment="Center" Click="OnSettingsClick"
                    ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
        </Grid>

        <!-- Add sources -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{x:Bind ViewModel.AddFilesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                    <TextBlock Text="Add files" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.AddFolderCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                    <TextBlock Text="Add folder" />
                </StackPanel>
            </Button>

            <TextBox Grid.Column="2"
                     PlaceholderText="Paste a YouTube or web URL…"
                     Text="{x:Bind ViewModel.UrlInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="3" Content="Add URL" Command="{x:Bind ViewModel.AddUrlCommand}" />
        </Grid>

        <!-- Output folder -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Output:" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox Grid.Column="1" IsReadOnly="True" Text="{x:Bind ViewModel.OutputFolder, Mode=OneWay}" />
            <Button Grid.Column="2" Content="Browse…" Command="{x:Bind ViewModel.BrowseOutputCommand}" />
            <Button Grid.Column="3" Command="{x:Bind ViewModel.OpenOutputCommand}" ToolTipService.ToolTip="Open output folder">
                <FontIcon Glyph="&#xE838;" FontSize="16" />
            </Button>
        </Grid>

        <!-- Queue + drop zone -->
        <Grid Grid.Row="3" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
            <Border Background="{ThemeResource SurfaceElev1Brush}"
                    BorderBrush="{ThemeResource SurfaceStrokeBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius.M}" />

            <!-- Empty hint -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.HasJobs, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                <FontIcon Glyph="&#xE896;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Drag &amp; drop files or folders here"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="…or use Add files / Add folder above"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Job list -->
            <ListView x:Name="JobsList"
                      ItemsSource="{x:Bind ViewModel.Jobs, Mode=OneWay}"
                      DataContext="{x:Bind ViewModel}"
                      SelectionMode="None"
                      Padding="6"
                      Visibility="{x:Bind ViewModel.HasJobs, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="8,6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:JobItem">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="4,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind TypeLabel}" FontSize="11" HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind RouteText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind Error, Mode=OneWay}" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="IndianRed"
                                           Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{x:Bind StatusText, Mode=OneWay}"
                                       Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                       VerticalAlignment="Center" />

                            <Button Grid.Column="3" VerticalAlignment="Center"
                                    Visibility="{x:Bind HasOutput, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.OpenFileCommand, ElementName=JobsList}"
                                    CommandParameter="{x:Bind}"
                                    ToolTipService.ToolTip="Open .md">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                            </Button>

                            <Button Grid.Column="4" VerticalAlignment="Center"
                                    Command="{Binding DataContext.RemoveCommand, ElementName=JobsList}"
                                    CommandParameter="{x:Bind}"
                                    ToolTipService.ToolTip="Remove">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Footer: actions + progress -->
        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.StatusSummary, Mode=OneWay}" />
                <ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" Maximum="100"
                             Visibility="{x:Bind ViewModel.IsConverting, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <Button Grid.Column="1" Content="Clear" Command="{x:Bind ViewModel.ClearCommand}"
                    Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

            <Button Grid.Column="2" Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}"
                    Visibility="{x:Bind ViewModel.IsConverting, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

            <Button Grid.Column="3" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ConvertCommand}"
                    Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8FB;" FontSize="16" />
                    <TextBlock Text="Convert" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Settings dialog (shown programmatically) -->
        <ContentDialog x:Name="SettingsDialog"
                       Title="Settings"
                       PrimaryButtonText="Save"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <StackPanel Spacing="16" MinWidth="320">
                <StackPanel Spacing="6">
                    <TextBlock Text="Theme" FontWeight="SemiBold" />
                    <ComboBox x:Name="ThemeCombo" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="System default" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Files converted at once" FontWeight="SemiBold" />
                    <NumberBox x:Name="ConcurrencyBox" Minimum="1" Maximum="32"
                               SpinButtonPlacementMode="Inline" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Scanned-PDF OCR resolution (DPI)" FontWeight="SemiBold" />
                    <NumberBox x:Name="DpiBox" Minimum="72" Maximum="600"
                               SpinButtonPlacementMode="Inline" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="OCR engine" FontWeight="SemiBold" />
                    <ComboBox x:Name="OcrEngineCombo" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Tesseract (built in, fast)" />
                        <ComboBoxItem Content="Surya (better tables/layout — large download)" />
                    </ComboBox>
                    <TextBlock x:Name="OcrEngineStatusText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="When a .md already exists" FontWeight="SemiBold" />
                    <ComboBox x:Name="OverwriteCombo" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Write a numbered copy" />
                        <ComboBoxItem Content="Overwrite" />
                        <ComboBoxItem Content="Skip" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Updates" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CheckUpdatesButton" Content="Check for updates"
                                Click="OnCheckUpdatesClick" />
                        <TextBlock x:Name="UpdateStatusText" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="AppVersionText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </ContentDialog>
    </Grid>
</UserControl>
