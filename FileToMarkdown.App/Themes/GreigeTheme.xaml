<!--
    Warm Greige color system (light/dark), tokenized per the project's design playbook.

    Palette (Warm Greige): light surface #F5F2EE / dark surface #1E1C1A, with a bronze
    accent replacing the old hardcoded #512BD4. Brushes are defined inside
    ThemeDictionaries so they flip automatically with Light/Dark/System.

    Do NOT override these keys elsewhere:
      AppBackgroundBrush, SurfaceElev1Brush, SurfaceElev2Brush, SurfaceStrokeBrush,
      TextPrimaryBrush, TextSecondaryBrush - they are the app's surface contract.

    AppBackgroundBrush is ~94% opaque so the Mica backdrop shimmers through subtly;
    on systems without Mica the bleed is imperceptible.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="GreigeSurfaceColor">#F5F2EE</Color>
            <Color x:Key="GreigeElev1Color">#EDE9E3</Color>
            <Color x:Key="GreigeElev2Color">#E4DFD8</Color>
            <Color x:Key="GreigeStrokeColor">#D9D4CF</Color>
            <Color x:Key="GreigeTextPrimaryColor">#2F2B28</Color>
            <Color x:Key="GreigeTextSecondaryColor">#6E6862</Color>
            <Color x:Key="GreigeAccentColor">#8E562E</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F0F5F2EE" />
            <SolidColorBrush x:Key="SurfaceElev1Brush" Color="{StaticResource GreigeElev1Color}" />
            <SolidColorBrush x:Key="SurfaceElev2Brush" Color="{StaticResource GreigeElev2Color}" />
            <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="{StaticResource GreigeStrokeColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource GreigeTextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource GreigeTextSecondaryColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource GreigeAccentColor}" />

            <!-- Map the accent onto WinUI's system accent brushes (no control re-templating). -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#8E562E" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#9C6238" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#7C4A26" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
            <Color x:Key="GreigeSurfaceColor">#1E1C1A</Color>
            <Color x:Key="GreigeElev1Color">#2B2927</Color>
            <Color x:Key="GreigeElev2Color">#363330</Color>
            <Color x:Key="GreigeStrokeColor">#3D3935</Color>
            <Color x:Key="GreigeTextPrimaryColor">#DAD6D2</Color>
            <Color x:Key="GreigeTextSecondaryColor">#A8A29C</Color>
            <Color x:Key="GreigeAccentColor">#D9A879</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F01E1C1A" />
            <SolidColorBrush x:Key="SurfaceElev1Brush" Color="{StaticResource GreigeElev1Color}" />
            <SolidColorBrush x:Key="SurfaceElev2Brush" Color="{StaticResource GreigeElev2Color}" />
            <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="{StaticResource GreigeStrokeColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource GreigeTextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource GreigeTextSecondaryColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource GreigeAccentColor}" />

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#D9A879" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E4B98D" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#C99765" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#1E1C1A" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <!-- Defer entirely to system high-contrast colors for accessibility. -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceElev1Brush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceElev2Brush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
