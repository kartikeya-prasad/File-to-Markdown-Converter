<!--
    Theme-independent design tokens: spacing, typography, radii.
    Color tokens live in GreigeTheme.xaml (they flip with light/dark).
    These keys are the app's design contract - reference them instead of literals.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Spacing scale -->
    <x:Double x:Key="Spacing.XS">4</x:Double>
    <x:Double x:Key="Spacing.S">8</x:Double>
    <x:Double x:Key="Spacing.M">12</x:Double>
    <x:Double x:Key="Spacing.L">16</x:Double>
    <x:Double x:Key="Spacing.XL">24</x:Double>

    <!-- Typography -->
    <FontFamily x:Key="Font.Primary">Segoe UI Variable</FontFamily>
    <x:Double x:Key="FontSize.Caption">12</x:Double>
    <x:Double x:Key="FontSize.Body">14</x:Double>
    <x:Double x:Key="FontSize.Subtitle">20</x:Double>
    <x:Double x:Key="FontSize.Title">28</x:Double>

    <!-- Radii -->
    <CornerRadius x:Key="Radius.S">4</CornerRadius>
    <CornerRadius x:Key="Radius.M">8</CornerRadius>
    <CornerRadius x:Key="Radius.L">12</CornerRadius>

</ResourceDictionary>
